# Point the storefront at your backend. Leave unset to run on the bundled seed
# catalog (the site stays fully browsable).
BACKEND_API_URL=https://api.yourdomain.com

# Optional: sent to your backend on every server-side request.
BACKEND_API_KEY=
# Optional: header name for the key. Defaults to Authorization (Bearer <key>).
BACKEND_API_KEY_HEADER=

# Optional: swap the geocoding provider used by the address picker.
GEOCODER_URL=https://photon.komoot.io
